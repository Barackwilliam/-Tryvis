# ---- Django ----
SECRET_KEY=change-this-to-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=tryvisinvestments.com,www.tryvisinvestments.com,tryvis.onrender.com
CSRF_TRUSTED_ORIGINS=https://tryvisinvestments.com,https://tryvis.onrender.com

# ---- Supabase Postgres (Settings > Database > Connection pooling) ----
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxx
DB_PASSWORD=your-db-password
DB_HOST=aws-0-eu-central-1.pooler.supabase.com
DB_PORT=6543

# ---- Supabase Storage bucket (Settings > Storage > S3 Connection) ----
USE_SUPABASE_STORAGE=True
SUPABASE_S3_ACCESS_KEY=your-s3-access-key
SUPABASE_S3_SECRET_KEY=your-s3-secret-key
SUPABASE_BUCKET_NAME=tryvis-media
SUPABASE_S3_ENDPOINT=https://your-project-ref.supabase.co/storage/v1/s3
SUPABASE_S3_REGION=eu-central-1
